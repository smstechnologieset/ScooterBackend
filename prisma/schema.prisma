generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String     @id @default(uuid())
  email     String     @unique
  role      String     @default("admin")
  status    String     @default("active")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  auditLogs AuditLog[]
}

model Scooter {
  id                  String              @id @default(uuid())
  deviceId            String              @unique
  simCcid             String?
  hardwareVersion     String?
  softwareVersion     String?
  firmwareVersion     String?
  batteryPercent      Int?
  signalStrength      Int?
  lockState           String              @default("unknown")
  rideState           String              @default("idle")
  authenticationState String              @default("unknown")
  online              Boolean             @default(false)
  lastHeartbeatAt     DateTime?
  lastGpsAt           DateTime?
  latitude            Float?
  longitude           Float?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  connections         ScooterConnection[]
  telemetry           ScooterTelemetry[]
  commands            Command[]
  commandHistory      CommandHistory[]
  locations           Location[]
}

model ScooterConnection {
  id               String    @id @default(uuid())
  scooterId        String?
  deviceId         String?
  socketId         String
  remoteAddress    String
  remotePort       Int?
  connectedAt      DateTime  @default(now())
  disconnectedAt   DateTime?
  disconnectReason String?
  scooter          Scooter?  @relation(fields: [scooterId], references: [id], onDelete: SetNull)

  @@index([deviceId])
  @@index([socketId])
  @@index([connectedAt])
}

model ScooterTelemetry {
  id             String   @id @default(uuid())
  scooterId      String?
  deviceId       String
  command        String
  sequence       String
  payloadFields  Json
  rawPacket      String
  batteryPercent Int?
  signalStrength Int?
  latitude       Float?
  longitude      Float?
  receivedAt     DateTime @default(now())
  scooter        Scooter? @relation(fields: [scooterId], references: [id], onDelete: SetNull)

  @@index([deviceId, receivedAt])
  @@index([scooterId, receivedAt])
}

model Command {
  id             String           @id @default(uuid())
  scooterId      String
  deviceId       String
  type           String
  status         String           @default("queued")
  sequence       String
  payload        Json
  error          String?
  retryCount     Int              @default(0)
  createdAt      DateTime         @default(now())
  sentAt         DateTime?
  acknowledgedAt DateTime?
  timedOutAt     DateTime?
  scooter        Scooter          @relation(fields: [scooterId], references: [id], onDelete: Cascade)
  history        CommandHistory[]

  @@index([deviceId, sequence])
  @@index([scooterId, status])
}

model CommandHistory {
  id        String   @id @default(uuid())
  commandId String?
  scooterId String
  deviceId  String
  type      String
  status    String
  message   String?
  packet    String?
  createdAt DateTime @default(now())
  command   Command? @relation(fields: [commandId], references: [id], onDelete: SetNull)
  scooter   Scooter  @relation(fields: [scooterId], references: [id], onDelete: Cascade)

  @@index([scooterId, createdAt])
  @@index([commandId])
}

model Location {
  id         String   @id @default(uuid())
  scooterId  String
  latitude   Float
  longitude  Float
  source     String
  recordedAt DateTime @default(now())
  scooter    Scooter  @relation(fields: [scooterId], references: [id], onDelete: Cascade)

  @@index([scooterId, recordedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json
  createdAt  DateTime @default(now())
  admin      Admin?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId, createdAt])
  @@index([entityType, entityId])
}

model Payment {
  id             String    @id @default(uuid())
  riderId        String
  rideId         String?
  amount         Int
  currency       String    @default("RWF")
  provider       String
  phoneNumber    String?
  status         String    @default("pending")
  transactionRef String?   @unique
  idempotencyKey String?   @unique
  failureReason  String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([riderId, createdAt])
  @@index([status])
  @@index([transactionRef])
}

model Wallet {
  id           String              @id @default(uuid())
  riderId      String              @unique
  balance      Int                 @default(0)
  currency     String              @default("RWF")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  transactions WalletTransaction[]

  @@index([riderId])
}

model WalletTransaction {
  id           String   @id @default(uuid())
  walletId     String
  amount       Int
  type         String
  reason       String
  paymentId    String?
  balanceAfter Int
  reference    String?
  createdAt    DateTime @default(now())
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
}

